# Copy to .env (never commit it) and fill in the values.
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_PASSWORD=
# Public host name; Caddy obtains the HTTPS certificate automatically (ports 80/443 must reach it).
PULSO_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
API_WORKERS=2
BACKUP_DAYS=14
